{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lower-bound-atlas:v1",
  "title": "Lower Bound Atlas registry document",
  "type": "object",
  "required": [
    "schemaVersion",
    "edition",
    "revision",
    "assumptions",
    "papers",
    "proofs",
    "reviews",
    "challenges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/challenge"
      }
    },
    "formulations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formulation"
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problem"
      }
    },
    "boundMoves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/$defs/objectLink" },
          "to": { "$ref": "#/$defs/objectLink" }
        }
      }
    },
    "releaseHypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true,
      "default": [
        "eth",
        "sh",
        "w1",
        "np_qp",
        "kxk"
      ]
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "paperId",
        "editionId",
        "locator",
        "role"
      ],
      "properties": {
        "paperId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "editionReason": {
          "type": "string",
          "minLength": 1
        },
        "editionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "enum": [
            "statement",
            "proof",
            "context",
            "forward",
            "correction"
          ]
        }
      }
    },
    "proofLink": {
      "type": "object",
      "required": [
        "proofId",
        "revision",
        "theorem"
      ],
      "properties": {
        "proofId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "theorem": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revisionLink": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "objectLink": {
      "type": "object",
      "required": [
        "type",
        "id",
        "revision"
      ],
      "properties": {
        "type": {
          "enum": [
            "bound",
            "proof"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "caseId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "theorem": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "direction": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "unassessed",
            "unknown",
            "established",
            "disproved"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "boundRevision",
              "reviewId"
            ],
            "properties": {
              "boundRevision": {
                "type": "integer",
                "minimum": 1
              },
              "hypothesisRevision": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              },
              "reviewId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "source": {
                "$ref": "#/$defs/citation"
              },
              "proof": {
                "$ref": "#/$defs/proofLink"
              }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "hypothesisRevision",
        "forward",
        "converse"
      ],
      "properties": {
        "hypothesisRevision": {
          "type": "integer",
          "minimum": 1
        },
        "forward": {
          "$ref": "#/$defs/direction"
        },
        "converse": {
          "$ref": "#/$defs/direction"
        }
      }
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "name",
        "aliases",
        "definition",
        "model",
        "quantifiers",
        "conventions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "researchStatus": { "enum": ["active", "historical"] },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "quantifiers": {
          "type": "string",
          "minLength": 1
        },
        "conventions": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          }
        },
        "refutation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bound": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "statement",
        "runtime",
        "inputFactor",
        "status",
        "provenance",
        "assumptions",
        "assumptionOperator",
        "sources",
        "proofs",
        "inputConditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "inputFactor": {
          "type": "string",
          "minLength": 1
        },
        "hardnessBaseline": {
          "enum": ["W[1]", "W[2]"],
          "description": "Parameterized hardness supporting a qualitative no-FPT lower bound under FPT ≠ W[1]."
        },
        "restrictions": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy description. The problem and bound inputConditions determine the scope."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy model string retained for older records. New bounds inherit the atlas default or specify a modelException."
        },
        "status": {
          "enum": [
            "established",
            "proposed",
            "conditional",
            "withdrawn",
            "invalidated"
          ]
        },
        "provenance": {
          "enum": [
            "literature",
            "atlas"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revisionLink"
          },
          "minItems": 1
        },
        "assumptionOperator": {
          "enum": [
            "all",
            "any"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proofLink"
          }
        },
        "assessments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/assessment"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bound"
          }
        },
        "reader": {
          "type": "object",
          "required": [
            "revision"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "notation": {
              "type": "string",
              "minLength": 1
            },
            "notationLabel": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "historicalNote": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "required": [
                      "url",
                      "text"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "path",
                      "text"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fragment": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "inputConditions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "includeInRelease": {
          "type": "boolean"
        },
        "modelException": {
          "type": "object",
          "description": "Use only if the theorem uses a different algorithmic model from the atlas default.",
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "runtimeSymbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "required": [
        "assumptionId",
        "status",
        "reason",
        "benchmarks",
        "recovered",
        "evidence"
      ],
      "properties": {
        "assumptionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "status": {
          "enum": [
            "needs-assessment",
            "open",
            "essentially-resolved",
            "resolved"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "remainingGap": {
          "type": "string",
          "minLength": 1
        },
        "nextStep": {
          "type": "string",
          "minLength": 1
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revisionLink"
          }
        },
        "recovered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revisionLink"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/proofLink"
              },
              {
                "$ref": "#/$defs/citation"
              }
            ]
          }
        },
        "includeInRelease": {
          "type": "boolean"
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "title",
        "aliases",
        "kind",
        "variant",
        "task",
        "encoding",
        "parameter",
        "bounds",
        "resolutions",
        "inputConditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy model string retained for older records. New bounds inherit the atlas default or specify a modelException."
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "restrictions": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy description. The problem and bound inputConditions determine the scope."
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bound"
          }
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolution"
          }
        },
        "coverage": {
          "type": [
            "string",
            "object"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "challenges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/challenge"
          }
        },
        "reader": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "parameterLabel": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "type": "string",
              "minLength": 1
            },
            "parameter": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            },
            "notation": {
              "type": "string",
              "minLength": 1
            },
            "boundContext": {
              "type": "string",
              "minLength": 1
            },
            "comments": {
              "type": "object"
            },
            "symbols": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "symbol",
                  "meaning"
                ],
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "additionalInput": {
              "type": "string",
              "minLength": 1
            },
            "parameterSymbols": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "symbol",
                  "meaning"
                ],
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "supersessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "problem",
              "hypothesis",
              "weaker",
              "weakerRevision",
              "stronger",
              "strongerRevision",
              "reason"
            ],
            "properties": {
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "hypothesis": {
                "type": "string",
                "minLength": 1
              },
              "weaker": {
                "type": "string",
                "minLength": 1
              },
              "weakerRevision": {
                "type": "integer",
                "minimum": 1
              },
              "stronger": {
                "type": "string",
                "minLength": 1
              },
              "strongerRevision": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "inputConditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "condition",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "string",
                "enum": [
                  "problem",
                  "bound"
                ]
              }
            }
          }
        },
        "recoveryDispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "hypothesis", "recovery", "reason"],
            "properties": {
              "target": {
                "$ref": "#/$defs/revisionLink"
              },
              "hypothesis": {
                "$ref": "#/$defs/revisionLink"
              },
              "recovery": {
                "$ref": "#/$defs/revisionLink"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "recoveryAssessments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "hypothesis",
              "recovery",
              "scale",
              "effective",
              "targetScale",
              "recoveredScale",
              "comparison",
              "evidence"
            ],
            "properties": {
              "target": {
                "$ref": "#/$defs/revisionLink"
              },
              "hypothesis": {
                "$ref": "#/$defs/revisionLink"
              },
              "recovery": {
                "$ref": "#/$defs/revisionLink"
              },
              "scale": {
                "type": "string",
                "enum": [
                  "full",
                  "logarithmic",
                  "degree"
                ]
              },
              "effective": {
                "type": "boolean"
              },
              "targetScale": {
                "type": "string",
                "minLength": 1
              },
              "recoveredScale": {
                "type": "string",
                "minLength": 1
              },
              "comparison": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/citation"
                    },
                    {
                      "$ref": "#/$defs/proofLink"
                    }
                  ]
                }
              }
            }
          }
        },
        "problemId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "problemRevision": {
          "type": "integer",
          "minimum": 1
        },
        "problemDefinitionHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "paper": {
      "type": "object",
      "required": [
        "id",
        "title",
        "authors",
        "preferredEditionId",
        "editions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "preferredEditionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["journal", "proceedings", "book", "preprint", "manuscript", "thesis", "periodical", "report", "other"]
              },
              "editionNumber": {
                "type": "integer",
                "minimum": 1
              },
              "doi": {
                "type": "string",
                "minLength": 1
              },
              "primaryUrl": {
                "type": "string",
                "minLength": 1
              },
              "openUrl": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "proof": {
      "type": "object",
      "required": [
        "id",
        "title",
        "revisions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "revision",
              "source",
              "theorems"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "pdf": {
                "type": "string",
                "minLength": 1
              },
              "theorems": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "number",
                    "statement"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "number": {
                      "type": "string",
                      "minLength": 1
                    },
                    "destination": {
                      "type": "string",
                      "minLength": 1
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/objectLink"
                }
              },
              "dependencyCoverage": {
                "enum": [
                  "partial",
                  "complete"
                ]
              },
              "authorship": {
                "type": "object",
                "required": [
                  "origin",
                  "kind"
                ],
                "properties": {
                  "origin": {
                    "enum": [
                      "atlas",
                      "external"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "ai",
                      "human"
                    ]
                  },
                  "authors": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "type",
        "date",
        "reviewer",
        "verdict",
        "scope",
        "evidence",
        "object"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "lean"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "verified",
            "qualified",
            "rejected"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "#/$defs/objectLink"
        },
        "independent": {
          "type": "boolean"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lean": {
          "type": "object",
          "required": [
            "toolchain",
            "commit",
            "declaration",
            "dependencies",
            "axioms",
            "buildEvidence",
            "correspondenceReviewId"
          ],
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "declaration": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "type": "string",
              "minLength": 1
            },
            "axioms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "buildEvidence": {
              "type": "string",
              "minLength": 1
            },
            "correspondenceReviewId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "required": [
        "id",
        "object",
        "reporter",
        "date",
        "objection",
        "evidence",
        "disposition",
        "decisions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "object": {
          "$ref": "#/$defs/objectLink"
        },
        "reporter": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "objection": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "open",
            "dismissed",
            "proof-gap",
            "withdrawn-support",
            "refuted"
          ]
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "reviewer",
              "reason",
              "evidence"
            ],
            "properties": {
              "date": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectLink"
          }
        }
      }
    },
    "formulation": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "hypothesisId",
        "hypothesisRevision",
        "name",
        "statement",
        "reference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "hypothesisId": {
          "type": "string",
          "minLength": 1
        },
        "hypothesisRevision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "refutation": {
          "type": "string",
          "minLength": 1
        },
        "equivalences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "caseId",
              "boundId",
              "boundRevision",
              "forward",
              "reverse",
              "source",
              "locator"
            ],
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1
              },
              "boundId": {
                "type": "string",
                "minLength": 1
              },
              "boundRevision": {
                "type": "integer",
                "minimum": 1
              },
              "forward": {
                "type": "string",
                "minLength": 1
              },
              "reverse": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "reverseSource": {
                "type": "string",
                "minLength": 1
              },
              "reverseLocator": {
                "type": "string",
                "minLength": 1
              },
              "additionalForwardSources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "locator"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "referenceLabel": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formulation"
          }
        }
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "input",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/problem"
          }
        },
        "restrictionOf": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "problemId",
              "condition"
            ],
            "properties": {
              "problemId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
