      "sourceBasis": {
        "kind": "derived",
        "step": "For each paired variable pair in the Cai–Juedes construction, two CNF clauses enforce exactly one true variable without adding variables. The CNF has O(h log r) variables for source weight h and r source variables. A computable exponent cutoff then bounds CNF-SAT time by a fixed power of r times a computable function of h, which would decide the W[1]-hard source problem in FPT time."
      },
      "sources": [
        {
          "editionId": "journal",
          "locator": "Lemma 3.1 and Corollary 3.1, §3, pp. 796–799",
          "paperId": "cai-juedes2003",
          "placement": "statement",
          "role": "paired-variable SAT reduction"
        }
      ],
      "statement": "Under FPT ≠ W[1], no deterministic algorithm decides CNF-SAT within the stated running time.",
      "status": "established",
      "supported": true
    }
