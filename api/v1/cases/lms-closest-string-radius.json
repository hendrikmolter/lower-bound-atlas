      "sourceBasis": {
        "kind": "derived",
        "step": "Add opposite unit clauses on two fresh variables. With L=n+2 positions and L+1 filler symbols, the two clauses ensure that both truth values and all fillers occur, giving q=d+4. Some filler is absent from every length-L center. The words using that filler require a satisfying literal in every clause. Conversely, a satisfying assignment agrees with every word. The encoding is polynomial and d=n+1 preserves the effective exponent scale."
      },
      "sources": [
        {
          "editionId": "journal",
          "locator": "Lemma 3.1 and Corollary 3.1 (Section 3). The paired-variable CNF-SAT source reduces to ordinary CNF-SAT on the same variables by adding the two clauses enforcing exactly one true variable in each pair.",
          "paperId": "cai-juedes2003",
          "placement": "statement",
          "role": "source lower bound",
          "scopeLabel": "CNF-SAT source"
        },
        {
          "editionId": "journal",
          "locator": "Theorem 3.1, proof in Section 3.1. Specialize the word construction to two truth-value symbols.",
          "paperId": "lms2018",
          "placement": "statement",
          "role": "target construction",
          "scopeLabel": "Closest String construction"
        }
      ],
      "statement": "Under FPT ≠ W[1], no deterministic algorithm decides Closest String within the stated running time.",
