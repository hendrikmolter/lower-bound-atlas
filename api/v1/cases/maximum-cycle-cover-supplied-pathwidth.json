      "sourceBasis": {
        "kind": "derived",
        "step": "The Cycle Packing lower bound under this hypothesis combines with the reduction in Lemma C.22. The reduction attaches a private three-vertex path and its closing edges at each vertex. A spanning cycle cover uses either a private triangle or a private four-cycle through the attachment vertex. The threshold increases by the original number of vertices, the complete output size grows polynomially, and the supplied width increases by at most three."
      },
      "sources": [
        {
          "editionId": "v3",
          "locator": "§3, Table 1, first row, p. 5, covering Theorem 14.19 of Parameterized Algorithms",
          "paperId": "szeider2026",
          "placement": "statement",
          "role": "Cycle Packing lower bound"
        },
        {
          "editionId": "book",
          "locator": "Theorem 14.19 and Exercise 14.8",
          "paperId": "cygan2015",
          "placement": "statement",
          "role": "Cycle Packing and Max Cycle Cover"
        },
        {
          "editionId": "journal",
          "locator": "Theorem 1.3, p. 17:4",
          "paperId": "cygan-cut-count",
          "placement": "statement",
          "role": "Historical bound for both problems"
        },
        {
          "editionId": "arxiv-v1",
          "editionReason": "The journal gives the pathwidth lower bound but omits Lemma C.22, which gives the transfer that adds at most three to the supplied pathwidth.",
          "locator": "Appendix C.4, Lemma C.22, p. 70",
          "paperId": "cygan-cut-count",
          "placement": "statement",
          "role": "Packing-to-cover reduction with width increase at most three"
        }
      ],
