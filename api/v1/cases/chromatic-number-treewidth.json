      "sourceBasis": {
        "kind": "derived",
        "step": "For fixed q, add a clique of q−3 vertices adjacent to every vertex of the 3-Coloring instance. These vertices use q−3 colors and increase treewidth by at most q−3. The new graph has at most q colors exactly when the original graph has at most three."
      },
      "sources": [
