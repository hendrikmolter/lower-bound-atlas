                "source": {
                  "editionId": "proceedings",
                  "locator": "§5.3, Theorem 11 and Corollary 12, pp. 6:13–6:14",
                  "paperId": "bodlaender2022-tree-structured",
                  "placement": "forward",
                  "role": "XALP-completeness for logarithmic treewidth"
                }
              }
            ],
            "sourceBasis": {
              "kind": "derived",
              "step": "Logarithmic-treewidth Vertex Cover is XALP-hard, so it is W[1]-hard. Discard the supplied decomposition from the reduction output. For a Clique input of order n and parameter k, the output treewidth is at most g(k)(1+log₂ n) for a computable g. Use the computable cutoff for a slope at most 1/g(k). Above the cutoff the exponential factor is polynomial in n, and below it the computable exponent has a finite maximum controlled by k. The polynomial-size reduction output then gives an FPT algorithm for Clique."
            },
            "status": "established"
          },
          "hypothesisRevision": 1,
          "verdict": "hypothesis-implies-bound"
        }
      },
